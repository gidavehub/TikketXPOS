<?xml version="1.0" encoding="utf-8"?>
<!-- Brand gradient screen header; extends under the transparent status bar
     and finishes with soft bottom corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/tikketx_red_bright"
                android:centerColor="@color/tikketx_red"
                android:endColor="@color/tikketx_red_deep" />
            <corners
                android:bottomLeftRadius="26dp"
                android:bottomRightRadius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/white_20"
                android:endColor="@android:color/transparent" />
            <corners
                android:bottomLeftRadius="26dp"
                android:bottomRightRadius="26dp" />
        </shape>
    </item>
</layer-list>
